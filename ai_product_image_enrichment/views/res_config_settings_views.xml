<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai_product_image_enrichment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Images" string="AI Images"
                     name="ai_product_image_enrichment" groups="base.group_system"
                     logo="/ai_product_image_enrichment/static/description/icon.png">

                    <block title="AI Service Credentials" id="ai_product_image_enrichment_credentials">
                        <setting string="Anthropic API Key" help="Your Claude API key. Stored as ir.config_parameter.">
                            <field name="aipie_anthropic_api_key" password="True"/>
                        </setting>
                        <setting string="Claude Model">
                            <field name="aipie_anthropic_model"/>
                        </setting>
                        <setting string="Search Provider">
                            <field name="aipie_search_provider"/>
                            <field name="aipie_search_api_key" password="True"/>
                        </setting>
                        <setting string="Photoroom API Key (recommended over rembg)">
                            <field name="aipie_photoroom_api_key" password="True"/>
                        </setting>
                        <setting string="Browserless (SPA fallback, optional)">
                            <field name="aipie_browserless_api_key" password="True"/>
                            <field name="aipie_browserless_endpoint"/>
                        </setting>
                    </block>

                    <block title="Pipeline Behavior" id="ai_product_image_enrichment_pipeline">
                        <setting string="Self-learning Recipe Cache">
                            <field name="aipie_recipe_cache_enabled"/>
                        </setting>
                        <setting string="Brand Attribute Name"
                                 help="Name of the product attribute that holds the manufacturer/brand name. The pipeline reads this attribute to identify the brand for each product.">
                            <field name="aipie_brand_attribute_name"/>
                        </setting>
                        <setting string="Max Images / Product">
                            <field name="aipie_max_images_per_product"/>
                        </setting>
                        <setting string="Min Image Width (px)">
                            <field name="aipie_min_image_width"/>
                        </setting>
                        <setting string="rembg Model">
                            <field name="aipie_rembg_model"/>
                            <button name="action_pre_warm_rembg" type="object" string="Pre-warm rembg model" class="btn-secondary"/>
                        </setting>
                    </block>

                    <block title="Normalization (visual uniformity)" id="ai_product_image_enrichment_normalization">
                        <setting string="Target Canvas Size (px)" help="Final image dimension (square). 1920 matches Odoo's image_1920 ceiling for maximum sharpness in auto-derived thumbnails.">
                            <field name="aipie_target_canvas_size"/>
                        </setting>
                        <setting string="Padding (%)" help="Whitespace around the product. THIS is what makes the shop grid look uniform.">
                            <field name="aipie_padding_percent"/>
                        </setting>
                        <setting string="Fallback Background Color" help="Used only if BG removal fails. Main image output is always transparent PNG; this color is never visible there.">
                            <field name="aipie_bg_color"/>
                        </setting>
                        <setting string="Fallback Output Format / Quality" help="Main images are always PNG with alpha. These settings only apply to the fallback / gallery code path.">
                            <field name="aipie_output_format"/>
                            <field name="aipie_jpeg_quality"/>
                        </setting>
                        <setting string="Studio-source Detection" help="Tunes how the analyzer classifies a source image as a studio shot vs a complex shot. Source-side only — does not affect output.">
                            <field name="aipie_white_threshold"/>
                            <field name="aipie_white_bg_min_percent"/>
                        </setting>
                        <setting string="Always Re-Normalize" help="Trim, center, and pad every product to the uniform canvas, regardless of source state. Required for visual shop-grid uniformity.">
                            <field name="aipie_force_normalize_existing"/>
                        </setting>
                        <setting>
                            <button name="action_open_preview_normalization" type="object" string="Preview Normalization" class="btn-primary"/>
                        </setting>
                    </block>

                    <block title="Safety" id="ai_product_image_enrichment_safety">
                        <setting string="Min Confidence">
                            <field name="aipie_min_confidence_score"/>
                        </setting>
                        <setting string="HTTP User-Agent">
                            <field name="aipie_user_agent"/>
                        </setting>
                        <setting string="Per-Domain Delay (s)">
                            <field name="aipie_request_delay_seconds"/>
                        </setting>
                        <setting string="Concurrent Workers">
                            <field name="aipie_concurrent_workers"/>
                        </setting>
                        <setting string="Keep Original Image Backup">
                            <field name="aipie_keep_backup"/>
                        </setting>
                    </block>

                    <block title="Cost Control" id="ai_product_image_enrichment_cost">
                        <setting string="Hourly Anthropic Cap (USD)"
                                 help="Hard kill-switch — refuses every Claude API call once trailing-hour spend hits this cap. Independent of jobs and cron logic. Set 0 to disable.">
                            <field name="aipie_hourly_ai_cap_usd"/>
                        </setting>
                        <setting string="Monthly Budget (USD)">
                            <field name="aipie_monthly_ai_budget_usd"/>
                        </setting>
                        <setting string="Alert Email">
                            <field name="aipie_alert_email"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
